# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
backend/venv/

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.local
.env.production
*.env

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
