# Vastu-AI Backend Configuration

# Debug mode (set to False in production)
DEBUG=True

# API settings
API_PREFIX=/api

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Generation settings
DEFAULT_VARIATIONS=3
MAX_VARIATIONS=5
IMAGE_WIDTH=800
IMAGE_HEIGHT=800

# Model settings
USE_GNN=False
MODEL_PATH=ml/models/floor_plan_gnn.pt
